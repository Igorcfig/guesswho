# Copy to .env (development) or .env.prod (production) and adjust the values.
# The .env and .env.* files do NOT go into git (only this .env.example).

# Port published on the host
APP_PORT=8000

# PostgreSQL database
# The password may contain special characters (@ : / # $ ...); in that case use single quotes:
#   POSTGRES_PASSWORD='my@strong#password'
POSTGRES_USER=cara
POSTGRES_PASSWORD=cara
POSTGRES_DB=cara

# (Optional) source code link shown on the home page
# REPO_URL=https://github.com/Igorcfig/guesswho
