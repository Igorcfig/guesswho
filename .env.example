# Copie para .env (desenvolvimento) ou .env.prod (produção) e ajuste os valores.
# Os arquivos .env e .env.* NÃO vão para o git (só este .env.example).

# Porta publicada no host
APP_PORT=8000

# Banco PostgreSQL
# A senha pode ter caracteres especiais (@ : / # $ ...); nesse caso use aspas simples:
#   POSTGRES_PASSWORD='minha@senha#forte'
POSTGRES_USER=cara
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cara
